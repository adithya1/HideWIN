# Database Configuration
# For high-scale production, replace with your PostgreSQL URI
DATABASE_URL=sqlite:///./hidewin.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# Redis Configuration (Required for 10k scale Rate Limiting & Session caching)
REDIS_URL=redis://localhost:6379/0

# Optional: Disable Redis fallback to purely local execution
# DISABLE_REDIS=true
