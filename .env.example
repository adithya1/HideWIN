# ==========================================
# Hide-WIN Environment Variables
# ==========================================

# Database
# Change this to your AWS RDS PostgreSQL URL in production!
DATABASE_URL=sqlite:///./hidewin.db

# API Settings
API_PORT=8000
ENVIRONMENT=development

# Cloud Relay Settings
RELAY_PORT=9000
# For horizontal scaling of WebSockets, provide a Redis URL for pub/sub messaging
REDIS_URL=

# Security
# Set this to your actual VPC domain in production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://hidewin.com
